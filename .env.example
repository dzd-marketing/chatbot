# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Students can choose TheStudent AI Auto, Flash v1, or Study v1. Auto routes
# on the server: NVIDIA -> Z.AI -> OpenCode tutor Space -> DZD Space. Flash v1
# stays on NVIDIA; Study v1 stays on the OpenCode tutor route. Busy models in
# Auto are skipped; if all are busy, it retries up to 3 times.

# Z.AI key for GLM-4.7-Flash, step 4 of the routing (server-side only)
# https://z.ai
ZAI_API_KEY=****
# optional, defaults to https://api.z.ai/api/paas/v4
# ZAI_BASE_URL=

# Final fallback: TheStudent's own gpt-oss-20b in a private Hugging Face Space
# with built-in web search (server-side only, never exposed to the browser).
# Use a fine-grained, READ-only Hugging Face token that can access the Space;
# never a write token. (HF_TOKEN is still accepted as a fallback.)
HF_READ_TOKEN=****
# optional, defaults to https://danuka21-dzd-learn-ai.hf.space
# DZD_AI_BASE_URL=
# optional, defaults to dzd-learn-gpt-oss-20b
# DZD_AI_MODEL=
# optional, max tokens per reply (default 700; the Space caps it at 1200)
# DZD_AI_MAX_TOKENS=

# OpenCode private Hugging Face Space (server-side only). Auto uses it as a
# fallback; Study v1 routes only here. It uses a separate HF token so this
# integration cannot change DZD's existing HF_TOKEN fallback. The route is
# enabled automatically when both credentials are configured. To disable it
# without removing credentials, set:
# OPENCODE_DISABLED=true
# The Space requires both headers: HF Bearer token and bridge key.
# Create a fine-grained, read-only token scoped to danuka21/opencode-web.
# OPENCODE_HF_TOKEN=
# Set this to the newly rotated Space secret BRIDGE_API_KEY (user role only).
# Never set BRIDGE_ADMIN_KEY or the OpenCode UI password in the web app.
# BRIDGE_API_KEY=
# optional, defaults to https://danuka21-opencode-web.hf.space
# OPENCODE_BASE_URL=
# optional, defaults to opencode/mimo-v2.6-flash-free
# OPENCODE_MODEL=

# NVIDIA API catalog (build.nvidia.com), server-side only: steps 1-3 of the
# routing. The free chat models from NVIDIA's /v1/models list are used.
NVIDIA_API_KEY=****
# optional extra keys (e.g. from other NVIDIA accounts): requests take turns
# across all keys, and a key that is rate limited (or can't use a model) is
# skipped automatically. Numbering can continue: _3, _4, ...
# NVIDIA_API_KEY_1=
# NVIDIA_API_KEY_2=
# optional, defaults to https://integrate.api.nvidia.com/v1
# NVIDIA_BASE_URL=
# optional, comma-separated NVIDIA model IDs to hide, e.g. meta/llama2-70b
# NVIDIA_HIDDEN_MODELS=

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# ---- TheStudent login (server-side values; defaults shown in lib/thestudent/api.ts)
# PHP API origin used for best-effort server-side logout. Default: https://app.quizontal.site
THESTUDENT_API_BASE=
# Expected web_assertion audience and logout Origin. Default: production site URL.
ASSISTANT_WEB_ORIGIN=
# If the PHP API requires it, sent as the X-TheStudent-Key header on logout.
THESTUDENT_WEB_CLIENT_KEY=
# Ed25519 SPKI DER Base64 key used to verify auth.php web_assertion.
# Default is the live key; set this to rotate the key without a code change.
THESTUDENT_ASSERTION_PUBKEY_SPKI=
# User-Agent for the best-effort server-side logout call. Keep this truthful.
# Default: TheStudentWeb/1.0
THESTUDENT_API_USER_AGENT=

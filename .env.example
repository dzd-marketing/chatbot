# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Students only see "TheStudent AI". Each reply is routed on the server
# (lib/ai/router.ts): NVIDIA Nemotron 3 Ultra -> NVIDIA gpt-oss-20b -> other
# free NVIDIA models -> Z.AI GLM-4.7-Flash -> the Hugging Face model below.
# Busy models are skipped; if all are busy it retries up to 3 times.

# Z.AI key for GLM-4.7-Flash, step 4 of the routing (server-side only)
# https://z.ai
ZAI_API_KEY=****
# optional, defaults to https://api.z.ai/api/paas/v4
# ZAI_BASE_URL=

# TheStudent AI model: gpt-oss-20b in a private Hugging Face Space with
# built-in web search (server-side only, never exposed to the browser).
# Use a fine-grained, READ-only Hugging Face token that can access the Space;
# never a write token. (HF_TOKEN is still accepted as a fallback.)
HF_READ_TOKEN=****
# optional, defaults to https://danuka21-dzd-learn-ai.hf.space
# DZD_AI_BASE_URL=
# optional, defaults to dzd-learn-gpt-oss-20b
# DZD_AI_MODEL=
# optional, max tokens per reply (default 700; the Space caps it at 1200)
# DZD_AI_MAX_TOKENS=

# NVIDIA API catalog (build.nvidia.com), server-side only: steps 1-3 of the
# routing. The free chat models from NVIDIA's /v1/models list are used.
NVIDIA_API_KEY=****
# optional extra keys (e.g. from other NVIDIA accounts): requests take turns
# across all keys, and a key that is rate limited (or can't use a model) is
# skipped automatically. Numbering can continue: _3, _4, ...
# NVIDIA_API_KEY_1=
# NVIDIA_API_KEY_2=
# optional, defaults to https://integrate.api.nvidia.com/v1
# NVIDIA_BASE_URL=
# optional, comma-separated NVIDIA model IDs to hide, e.g. meta/llama2-70b
# NVIDIA_HIDDEN_MODELS=

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# TheStudent app <-> website SSO (server-side only; never NEXT_PUBLIC_).
# Set real values in Vercel -> Project Settings -> Environment Variables and
# in an untracked .env.local for local work. Never commit real values.
# 64 hexadecimal characters, byte-identical to the PHP server's secret.
ASSISTANT_SSO_SECRET=
# Optional: https origin of TheStudent PHP API (https://, no trailing slash).
# Defaults to the production API when unset (see lib/sso/config.ts).
THESTUDENT_API_BASE=
# Optional: https origin of this website (https://, no trailing slash).
# Defaults to the production site when unset. Must match the Android app's
# pinned origin (WebAssistantConfig.PRODUCTION_ORIGIN).
ASSISTANT_WEB_ORIGIN=
# Optional: path the app POSTs its one-time code to (defaults to /api/app-auth).
ASSISTANT_EXCHANGE_PATH=
